# Todos os valores VITE_* são públicos (embutidos no bundle). Nunca coloque segredos aqui.
VITE_API_BASE_URL=/api
# Destino do proxy de desenvolvimento (somente servidor Vite, não vai para o bundle).
DEV_PROXY_TARGET=http://localhost:8000
# No Docker Compose (repositório sigtcc-backend) estes valores são definidos pelo próprio compose.yaml
# (DEV_PROXY_TARGET=http://backend:8000); este arquivo vale apenas para execução fora do Docker.
