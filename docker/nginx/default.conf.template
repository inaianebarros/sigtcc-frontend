# Renderizado pelo entrypoint do nginx (envsubst) a cada subida: só as variáveis de ambiente definidas
# (${PORT}, ${BACKEND_URL}, ${NGINX_LOCAL_RESOLVERS}) são substituídas; as variáveis do nginx ($uri etc.)
# ficam intactas.

# IP do cliente: o X-Real-IP da borda do Railway; sem ele, o IP de quem conectou ao nginx.
map $http_x_real_ip $client_ip {
    default $http_x_real_ip;
    ""      $remote_addr;
}

# O X-Forwarded-Proto vindo da borda é preservado; sem ele (acesso direto) vale o esquema local.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolve o nome do backend a cada 10 s, em tempo de execução (não só na subida), então o proxy
    # sobe mesmo sem o backend e acompanha mudanças de IP. Servidores vêm de /etc/resolv.conf.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    server_tokens off;
    client_max_body_size 11m; # anexos de até 10 MB (backend: MAX_FILE_SIZE_BYTES) + envelope multipart

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain;

    # Cabeçalhos de segurança: incluídos em cada location que serve a SPA. O /api não os recebe, porque
    # o próprio Django já envia os dele (repetir duplicaria os cabeçalhos).

    # Saúde do próprio nginx; não depende do backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        return 200 "ok\n";
    }

    # API: o caminho /api é preservado (proxy_pass sem URI). Cookies, Origin e Host seguem sem alteração.
    location /api/ {
        set $backend_upstream "${BACKEND_URL}";
        proxy_pass $backend_upstream;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        # O IP do cliente é o que a borda do Railway informa no X-Real-IP; o X-Forwarded-For dela não
        # traz o cliente de forma confiável. O nginx o repassa como único valor do X-Forwarded-For,
        # então o backend conta UM salto (NUM_PROXIES=1, ADR backend 0007) e um X-Forwarded-For
        # forjado pelo cliente é descartado. Sem X-Real-IP (acesso direto), vale o IP da conexão.
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;

        proxy_connect_timeout 5s;
        proxy_send_timeout 35s;
        proxy_read_timeout 35s; # gunicorn do backend tem timeout de 30 s
    }

    # Arquivos com hash no nome: nunca mudam. Arquivo ausente é 404, não o index.html.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # SPA: qualquer outra rota cai no index.html (React Router); ele nunca fica em cache.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
